{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pad01g/proxy-shopping-go/shopper-bot/schema/PurchaseRequest.json",
  "title": "PurchaseRequest",
  "type": "object",
  "required": ["request_id", "order_id", "shop_url", "items", "shipping", "payment_ref", "max_amount"],
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "order_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "shop_url": {"type": "string", "pattern": "^https?://[^/\\s]+(/.*)?$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "qty"],
        "additionalProperties": false,
        "properties": {
          "sku": {"type": "string", "minLength": 1, "maxLength": 64},
          "qty": {"type": "integer", "minimum": 1, "maximum": 99}
        }
      }
    },
    "shipping": {"$ref": "Address.json"},
    "payment_ref": {
      "description": "A reference to payment means held by the bot. Card data never travels in requests.",
      "type": "string",
      "pattern": "^(cash|card:[a-z0-9_-]+)$"
    },
    "max_amount": {"$ref": "Money.json"}
  }
}
