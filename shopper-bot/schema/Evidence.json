{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pad01g/proxy-shopping-go/shopper-bot/schema/Evidence.json",
  "title": "Evidence",
  "description": "A captured artifact. sha256 is the lowercase hex digest of the raw bytes that data_b64 encodes.",
  "type": "object",
  "required": ["kind", "sha256", "mime"],
  "additionalProperties": false,
  "properties": {
    "kind": {"enum": ["screenshot", "receipt", "html", "json"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mime": {"type": "string", "minLength": 1},
    "data_b64": {"type": "string", "contentEncoding": "base64"}
  }
}
