{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pad01g/proxy-shopping-go/shopper-bot/schema/Money.json",
  "title": "Money",
  "description": "A decimal amount as a string (spec: amounts are never JSON numbers).",
  "type": "object",
  "required": ["amount", "currency"],
  "additionalProperties": false,
  "properties": {
    "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3,5}$"}
  }
}
