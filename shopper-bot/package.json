{
  "name": "shopper-bot",
  "version": "1.0.0",
  "description": "Shop automation for proxy-shopping shoppers (spec §9)",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
